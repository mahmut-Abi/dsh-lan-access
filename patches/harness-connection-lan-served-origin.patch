+
+/**
+ * Whether a normalized URL hostname is a non-loopback IPv4 literal. A page
+ * served from such an origin can only have come from a host that bound an
+ * all-interfaces socket on that address — the LAN-served deployment case —
+ * so consumers treat it like loopback for capability decisions; the /api
+ * fence still decides actual request trust. (IPv6 LAN literals are not
+ * classified today; loopback IPv6 is covered by {@link isLoopbackHostname}.)
+ * @param hostname - WHATWG URL hostname (IPv6 literals retain brackets).
+ * @returns true for any dotted-quad IPv4 literal outside 127/8.
+ */
+export function isServedLanHostname(hostname: string): boolean {
+  const parts = hostname.split('.')
+  if (parts.length !== 4) return false
+  if (!parts.every(part => /^\d{1,3}$/.test(part) && Number(part) <= 255)) return false
+  return parts[0] !== '127'
+}
